{
  "name": "scala-parser",
  "displayName": "Scala Parser Language Support",
  "description": "Language support for the Scala Parser lambda calculus language",
  "version": "0.1.0",
  "publisher": "scala-parser",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:scala-parser"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "scala-parser",
        "aliases": [
          "Scala Parser",
          "scala-parser"
        ],
        "extensions": [
          ".sp",
          ".scala"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "scala-parser",
        "scopeName": "source.scala-parser",
        "path": "./syntaxes/scala-parser.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "scala-parser.restart",
        "title": "Scala Parser: Restart Language Server"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.125.0",
    "typescript": "^6.0.3",
    "vscode-languageclient": "^10.0.0"
  }
}
